{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "insights.schema.json",
  "title": "insights.json — Perceptron Mk1 readings of satellite frames / time-lapse, per zone",
  "type": "object",
  "required": ["model", "items"],
  "properties": {
    "model": {"type": "string"},
    "spent_usd": {"type": "number"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["zone_id", "kind", "summary"],
        "properties": {
          "zone_id": {"type": ["string", "null"]},
          "kind": {"enum": ["timelapse", "tile", "field_boundaries"]},
          "summary": {"type": "string", "description": "One or two sentences shown in the UI"},
          "counts": {
            "type": "object",
            "properties": {
              "harvested": {"type": "integer"}, "standing": {"type": "integer"}, "burned": {"type": "integer"}
            }
          },
          "clips": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {"start": {"type": "string"}, "end": {"type": "string"}, "label": {"type": "string"}}
            }
          },
          "raw": {"description": "Raw model response for debugging"}
        }
      }
    }
  }
}
