# Copy to web/.env for local work. The Pages build reads the same names from repository variables.
VITE_SUPABASE_URL=            # the Supabase project URL (Project settings, API); empty runs the site without accounts
VITE_SUPABASE_ANON_KEY=       # that project's anon key; public by design, row-level security is the fence
VITE_API_BASE=                # the developer API base, normally https://<ref>.supabase.co/functions/v1/api; derived from the URL above when empty
VITE_SIGNUP_URL=              # where "Get your farm's morning plan" points; default http://localhost:8788/signup
