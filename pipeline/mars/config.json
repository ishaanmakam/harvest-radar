{
  "mars_radius_km": 3389.5,
  "km_per_degree_latitude": 59.16,
  "grid": {
    "cell_deg": 0.125,
    "lat_min": -60,
    "lat_max": 60,
    "lon_min": -180,
    "lon_max": 180,
    "lon_convention": "east-positive, -180..180",
    "latitude": "planetocentric"
  },
  "factors": {
    "ice": {
      "name": "Ice within reach",
      "from": "spacex",
      "dataset": "SWIM ice consistency, 0-1 m and 1-5 m (PSI)",
      "why": "Water for propellant, air and crops.",
      "go": "0-1 m consistency >= 0.25, or 1-5 m consistency >= 0.5",
      "watch": "0-1 m consistency >= 0, or 1-5 m consistency >= 0.25",
      "no_go": "otherwise",
      "goodness_rule": "max((c01 + 1) / 2, 0.85 x (c15 + 1) / 2)",
      "cutoffs": {
        "go_c01": 0.25,
        "go_c15": 0.5,
        "watch_c01": 0.0,
        "watch_c15": 0.25,
        "c15_factor": 0.85
      }
    },
    "low_elevation": {
      "name": "Low ground",
      "from": "spacex",
      "dataset": "MOLA MEGDR elevation, 16 pixels per degree (NASA PDS)",
      "why": "More atmosphere to slow the ship.",
      "go": "elevation <= -2,500 m",
      "watch": "elevation <= 0 m",
      "no_go": "above 0 m",
      "goodness_rule": "1 at -4,000 m or lower, 0 at +1,000 m or higher, linear between",
      "cutoffs": {
        "go_m": -2500,
        "watch_m": 0,
        "good_m": -4000,
        "bad_m": 1000
      }
    },
    "plume_safe_ground": {
      "name": "Plume-safe ground",
      "from": "ours",
      "dataset": "MGS TES nighttime thermal inertia, 20 pixels per degree (Putzig and Mellon, PSI)",
      "why": "Firm soil the engines will not dig out: very low inertia is loose dust, very high is rock and bedrock.",
      "go": "180 <= TI <= 500",
      "watch": "120 <= TI < 180, or 500 < TI <= 700",
      "no_go": "TI < 120 (loose dust) or TI > 700 (rock, bedrock)",
      "goodness_rule": "trapezoid: 0 at 80, 1 from 180 to 500, 0 at 800",
      "cutoffs": {
        "go_lo": 180,
        "go_hi": 500,
        "watch_lo": 120,
        "watch_hi": 700,
        "ramp_lo": 80,
        "ramp_hi": 800
      }
    },
    "science_reach": {
      "name": "Science reach",
      "from": "ours",
      "dataset": "USGS Mars Global Geologic Map, SIM 3292 (Tanaka et al. 2014)",
      "why": "More kinds of rock within a rover's range, and rock from the wet early eras.",
      "go": ">= 4 distinct units within about 100 km, including a Noachian or Hesperian one",
      "watch": ">= 2 units",
      "no_go": "1 unit (a uniform plain)",
      "goodness_rule": "0.7 x min(1, units / 6) + 0.3 x (1 if an old unit is within reach else 0)",
      "cutoffs": {
        "reach_km": 100,
        "go_units": 4,
        "watch_units": 2,
        "units_for_full": 6,
        "old_weight": 0.3,
        "coarse_cell_deg": 0.5
      }
    },
    "magnetic_shelter": {
      "name": "Magnetic shelter",
      "from": "ours",
      "dataset": "crustal magnetic field grid (not available in this run)",
      "why": "Patches of magnetized crust add a little local radiation cover.",
      "go": "above the 66th percentile of |B|",
      "watch": "above the 33rd percentile",
      "no_go": "below",
      "goodness_rule": "|B| scaled over its 5th to 95th percentile",
      "cutoffs": {
        "go_pct": 66,
        "watch_pct": 33,
        "scale_lo_pct": 5,
        "scale_hi_pct": 95
      }
    }
  },
  "weights": {
    "without_magnetic": {
      "ice": 0.35,
      "low_elevation": 0.2,
      "plume_safe_ground": 0.25,
      "science_reach": 0.2
    },
