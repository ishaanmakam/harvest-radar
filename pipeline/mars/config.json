    }
  },
  "shown_not_scored": [
    {
      "id": "slope",
      "name": "Regional slope",
      "why": "Flat, rock-free ground is SpaceX's own screen and needs HiRISE at landing scale; a 20 km slope is context, not a verdict."
    },
    {
      "id": "latitude",
      "name": "Latitude",
      "why": "Sunlight and power are SpaceX's own screen (within about 40 degrees of the equator); we show it and leave it to them."
    },
    {
      "id": "albedo",
      "name": "Dust (albedo)",
      "why": "Bright ground usually means a dust cover; thermal inertia already scores the firmness, so albedo stays context."
    }
